# Copy to .env (git-ignored) and fill in. The online public-corpus builder and explicitly enabled
# public-source Groq demo worker read credentials here. The default app remains offline; keys
# never enter browser code. Private documents are never sent to these cloud providers.
#
# Google Gemini API key, used only to extract fact patterns from PUBLIC precedent documents.
# Use a paid-tier key: Google may use data sent on the free tier to improve its products.
GEMINI_API_KEY=

# Optional Groq public-source worker. Never expose the key in Vite/browser code.
# Start the local React server with --groq-demo; private records are refused.
# --groq-demo and the maintainer commands read GROQ_API_KEY here. GROQ_MODEL here applies to the
# maintainer commands only; for --groq-demo, export GROQ_MODEL in the shell.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
